          "type": "string",
        },
        "flagged_only": {
          "type": "boolean",
        },
        "folder": {
          "description": "Folder to search. Defaults to INBOX.",
          "minLength": 1,
          "type": "string",
        },
        "from": {
          "minLength": 1,
          "type": "string",
        },
