                "minLength": 1,
                "type": "string",
              },
              "uid": {
                "exclusiveMinimum": 0,
                "type": "integer",
              },
            },
            "required": [
              "folder",
              "uid",
              "part_id",
            ],
            "type": "object",
          },
          "maxItems": 10,
          "type": "array",
        },
        "body": {
          "type": "string",
        },
        "cc": {
          "items": {
            "format": "email",
            "type": "string",
          },
          "maxItems": 50,
          "type": "array",
        },
        "in_reply_to": {
          "additionalProperties": false,
          "properties": {
            "folder": {
              "description": "Folder of the message being answered.",
              "minLength": 1,
              "type": "string",
            },
            "uid": {
              "description": "Uid of the message being answered.",
              "exclusiveMinimum": 0,
              "type": "integer",
            },
          },
          "required": [
            "folder",
            "uid",
          ],
          "type": "object",
        },
        "quote_original": {
          "description": "Add the original below the body as a quote. Needs in_reply_to.",
          "type": "boolean",
        },
        "subject": {
          "type": "string",
        },
        "to": {
          "description": "Recipients. At least one is required.",
          "items": {
            "format": "email",
            "type": "string",
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array",
        },
      },
      "required": [
        "to",
        "subject",
        "body",
      ],
      "type": "object",
    },
    "name": "send_email",
    "title": undefined,
  },
  {
    "_meta": undefined,
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Mark a message read/unread and/or flagged/unflagged. Provide at least one of seen or flagged.",
    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "flagged": {
          "description": "true flags the message, false clears the flag.",
          "type": "boolean",
        },
        "folder": {
          "minLength": 1,
          "type": "string",
        },
        "seen": {
          "description": "true marks the message read, false marks it unread.",
          "type": "boolean",
        },
        "uid": {
