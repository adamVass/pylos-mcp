          "minLength": 1,
          "type": "string",
        },
        "folder": {
          "minLength": 1,
          "type": "string",
        },
        "uid": {
          "exclusiveMinimum": 0,
          "type": "integer",
        },
      },
      "required": [
        "folder",
        "uid",
        "destination",
      ],
      "type": "object",
    },
    "name": "move_email",
    "title": undefined,
  },
  {
    "_meta": undefined,
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true,
    },
